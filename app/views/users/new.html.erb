<div class="home-container">
<h1>登録画面</h1>
<% if @user.errors.any? %>
  <div style="color: red;">
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: @user do |f| %>

  <p>名前<br>
  <%= f.text_field :name %></p><br>

  <p>パスワード<br>
  <%= f.password_field :password %></p><br>

  <%= f.submit "新規登録" %>

<% end %>

<p>
  <%= link_to "ログイン", login_path %>
</p>
</div>