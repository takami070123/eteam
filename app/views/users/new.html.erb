<div class="home-container">
  <div class="home-center">
    <h1>登録画面</h1>
    <% if @user.errors.any? %>
      <div style="color: red;">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form_with model: @user do |f| %>

      <p>名前</p>
      <%= f.text_field :name %>

      <p>パスワード</p>
      <%= f.password_field :password %><br><br>

      <%= f.submit "新規登録" %>

    <% end %>

    <p>
      <%= link_to "ログイン", login_path %>
    </p>
  </div>
</div>