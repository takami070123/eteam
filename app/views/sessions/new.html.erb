<div class="home-container">
<h1>ログイン</h1>

<%= form_with url: login_path, method: :post do |f| %>

  <p>ユーザー名</p>
  <%= f.text_field :name %>

  <p>パスワード</p>
  <%= f.password_field :password %>

  <br><br>

  <%= f.submit "ログイン" %>

<% end %>

<p>
  <%= link_to "新規登録はこちらから", new_user_path %>
</p>
</div>