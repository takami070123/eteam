<h1>HOME</h1>

<p>ようこそ、<%= current_user.name %>さん！</p>

<%= button_to "始める", game_start_path, method: :post %>

<br>
<%= link_to "ランキング", ranking_path %>
<br>

<% if current_user.present? %>
  <%= button_to "アカウント削除",
      user_path(current_user),
      method: :delete,
      data: { turbo_confirm: "本当にアカウントを削除しますか？" } %>
<% end %>
<br>

<%= link_to "ログアウト", logout_path, data: { turbo_method: :delete } %>
